# ---- Secrets: never commit real keys ----
.env
.env.*
!.env.example
*.pem
*.key

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/

# ---- Node / build output ----
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# ---- Temporary files from the audit trail and approvals writers ----
*.json.tmp

# ---- SQLite side files (the two .db files themselves ARE committed) ----
*.db-journal
*.db-wal
*.db-shm

# ---- OS / editor / tool folders ----
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
.claude/
*.log
