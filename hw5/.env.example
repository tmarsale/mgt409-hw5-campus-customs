# Campus Customs HW5 settings template. Copy to .env and fill in your own values.
# Never commit .env (it is in .gitignore). This file holds placeholders only.

# Portkey gateway key used for every AI call (all agents use gpt-6-luna)
PORTKEY_API_KEY=your-portkey-api-key-here

# The only model the HW5 agents may use
OPENAI_MODEL=gpt-6-luna

# Optional: Portkey gateway URL (this is the default)
PORTKEY_BASE_URL=https://api.portkey.ai/v1

# A private code you type in the dashboard to approve payments and status changes.
# Approvals stay switched off while this is empty.
CAMPUS_CUSTOMS_APPROVAL_CODE=choose-your-own-private-code
